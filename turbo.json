{
	"$schema": "https://turbo.build/schema.json",
	"globalPassThroughEnv": ["DATABASE_URL", "NODE_ENV"],
	"tasks": {
		"build": {
			"dependsOn": ["^build", "prisma:generate"],
			"outputs": ["dist/**", ".next/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"lint": {},
		"prisma:generate": {
			"cache": false
		},
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false,
			"persistent": true
		},
		"db:deploy": {
			"cache": false
		},
		"db:seed": {
			"cache": false
		},
		"db:reset": {
			"cache": false
		}
	}
}
