{
	"name": "@bivium/infrastructure",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./prisma": "./generated/client/index.js"
	},
	"scripts": {
		"prisma:generate": "prisma generate --schema=./src/prisma/schema",
		"db:migrate": "prisma migrate dev --schema=./src/prisma/schema",
		"db:deploy": "prisma migrate deploy --schema=./src/prisma/schema",
		"db:reset": "prisma migrate reset --schema=./src/prisma/schema",
		"prebuild": "pnpm run prisma:generate",
		"build": "tsc -b",
		"typecheck": "tsc -b --noEmit"
	},
	"dependencies": {
		"@bivium/application": "workspace:*",
		"@bivium/common": "workspace:*",
		"@bivium/domain": "workspace:*",
		"@prisma/client": "^5.22.0",
		"alchemy-sdk": "^3.5.6",
		"amqplib": "^0.10.4",
		"dotenv": "^16.4.7",
		"inversify": "^7.10.4",
		"prisma": "^5.22.0",
		"reflect-metadata": "^0.2.2",
		"tslib": "^2.8.1",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/amqplib": "^0.10.5"
	}
}
