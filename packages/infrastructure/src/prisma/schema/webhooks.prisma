model OnchainEvent {
  id              String               @id @default(uuid())
  provider        OnchainEventProvider
  payload         Json
  processed       Boolean              @default(false)
  error           Boolean              @default(false)
  timesProcessed  Int                  @default(0) @map("times_processed")
  lastProcessedAt DateTime?            @map("last_processed_at")
  createdAt       DateTime             @default(now()) @map("created_at")

  @@index([provider, processed, createdAt])
  @@map("onchain_events")
}

model OutboxEvent {
  id            String            @id @default(uuid())
  exchange      String            @default("bivium.events")
  routingKey    String            @map("routing_key")
  event         Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  lastError     String?           @map("last_error")
  lastAttemptAt DateTime?         @map("last_attempt_at")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}
