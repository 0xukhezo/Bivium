generator client {
  provider        = "prisma-client-js"
  output          = "../../../generated/client"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // The indexer (Ponder) schema is intentionally NOT listed here — it is
  // owned by apps/indexer and read via raw SQL (see MarketSummaryRepository).
}
