# Node environment: local | development | production
NODE_ENV=local

# ─── Database (Postgres) ─────────────────────────────────────────────────────
# Match the credentials in docker-compose-local.yml when running locally
DATABASE_URL=postgresql://bivium:bivium@localhost:5432/bivium?schema=public

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://bivium:bivium@localhost:5672

# ─── Alchemy ─────────────────────────────────────────────────────────────────
# Webhook signing key — used by apps/watcher to verify the HMAC signature
# Get it from the Alchemy dashboard for the Address Activity webhook
ALCHEMY_SIGNING_KEY=replace-me

# Alchemy API key — used by apps/reactor to fetch balances via RPC
ALCHEMY_API_KEY=replace-me

# ─── apps/watcher ────────────────────────────────────────────────────────────
WATCHER_PORT=3001
API_VERSION=v1

# Outbox poller (runs inside watcher)
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5

# ─── apps/reactor ────────────────────────────────────────────────────────────
# (Only DATABASE_URL, RABBITMQ_URL, ALCHEMY_API_KEY needed — already above)

# ─── apps/api ────────────────────────────────────────────────────────────────
API_PORT=3000

# Postgres schema the markets endpoint reads from. Ponder writes to
# `indexer_dev` directly in local dev; in production the blue/green deploy
# publishes a stable `indexer` views schema.
INDEXER_SCHEMA=indexer_dev

# Optional: comma-separated CORS allow-list. Empty = allow all (dev only).
# CORS_ORIGINS=https://app.bivium.xyz,https://staging.bivium.xyz

# ─── apps/jobs ───────────────────────────────────────────────────────────────
# LiFi /tokens endpoint for USD price refresh. Public URL is rate-limited;
# set LIFI_API_KEY if you need higher throughput.
LIFI_API_URL=https://li.quest/v1
# LIFI_API_KEY=replace-me
LIFI_TIMEOUT_MS=10000

# Cron expression for the asset-price refresh job (node-schedule syntax).
PRICE_REFRESH_CRON=*/2 * * * *
