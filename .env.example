# Node environment: local | development | production
NODE_ENV=local

# ─── Database (Postgres) ─────────────────────────────────────────────────────
# Match the credentials in docker-compose-local.yml when running locally
DATABASE_URL=postgresql://bivium:bivium@localhost:5432/bivium?schema=public

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://bivium:bivium@localhost:5672

# ─── Alchemy ─────────────────────────────────────────────────────────────────
# Webhook signing key — used by apps/watcher to verify the HMAC signature
# Get it from the Alchemy dashboard for the Address Activity webhook
ALCHEMY_SIGNING_KEY=replace-me

# Alchemy API key — used by apps/reactor to fetch balances via RPC
ALCHEMY_API_KEY=replace-me

# ─── apps/watcher ────────────────────────────────────────────────────────────
WATCHER_PORT=3001
API_VERSION=v1

# Outbox poller (runs inside watcher)
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5

# ─── apps/reactor ────────────────────────────────────────────────────────────
# (Only DATABASE_URL, RABBITMQ_URL, ALCHEMY_API_KEY needed — already above)

# ─── apps/api ────────────────────────────────────────────────────────────────
API_PORT=3000

# Postgres schema the markets endpoint reads from. Must match the indexer's
# DATABASE_SCHEMA (set below). For local dev use `indexer_dev`; in production
# bump to `indexer_v2`, `indexer_v3`… on each schema-breaking change to force
# a clean Ponder reindex while the previous schema stays around for rollback.
INDEXER_SCHEMA=indexer_dev

# Optional: comma-separated CORS allow-list. Empty = allow all (dev only).
# CORS_ORIGINS=https://app.bivium.xyz,https://staging.bivium.xyz

# ─── apps/jobs ───────────────────────────────────────────────────────────────
# LiFi /tokens endpoint for USD price refresh. Public URL is rate-limited;
# set LIFI_API_KEY if you need higher throughput.
LIFI_API_URL=https://li.quest/v1
# LIFI_API_KEY=replace-me
LIFI_TIMEOUT_MS=10000

# Cron expression for the asset-price refresh job (node-schedule syntax).
PRICE_REFRESH_CRON=*/2 * * * *

# ─── apps/indexer (Ponder) ───────────────────────────────────────────────────
# Arbitrum mainnet RPC URL (chainId 42161). Use a paid endpoint — public RPCs
# rate-limit the backfill.
PONDER_RPC_URL_42161=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Per-deploy private schema where Ponder writes during indexing + reorg
# handling. Must match INDEXER_SCHEMA above so the API reads the same data.
DATABASE_SCHEMA=indexer_dev

# Public views schema for external readers. Stable across deployments; views
# get repointed atomically on each publish (read-side not wired yet).
DATABASE_VIEWS_SCHEMA=indexer

# Contract addresses (Arbitrum mainnet) — source of truth:
# apps/contracts/broadcast/Deploy.s.sol/42161/run-latest.json
BIVIUM_ADDRESS=0xcba56b1742e35687f6812e42ea8d43ed7b2a4a0f
BIVIUM_EVENT_EMITTER_ADDRESS=0xca0197eb2156fc871299c7213e3abc9478e1575d
BIVIUM_ROUTER_ADDRESS=0x9ae169dfaa41dcf95014b88c7d9969f5d8fa58ae

# Start block — earliest deploy tx (BiviumEventEmitter at block 469017514).
# Do NOT set to 0: would full-chain backfill and exhaust your RPC quota.
BIVIUM_START_BLOCK=469017514
