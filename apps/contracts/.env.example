# Deployer EOA — becomes Bivium owner + Emitter DEPLOYER.
# Use a fresh hot wallet for the hackathon; never reuse a key with mainnet funds.
PRIVATE_KEY=0x

# RPC endpoints (referenced by [rpc_endpoints] aliases in foundry.toml)
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Etherscan / Arbiscan verification key
# https://arbiscan.io/myapikey
ARBISCAN_API_KEY=

# ── CurateToken.s.sol inputs (only needed when running curate-token:*) ──
# Example values (replace before running):
# COLLATERAL=0x...
# LOAN=0x...                # ERC-20 loan token the oracle prices `COLLATERAL` against
# ORACLE=0x...              # oracle returning price scaled `1e36 + loanDec - collateralDec`
# LLTV=860000000000000000   # 86% = 0.86 * 1e18
