# Postgres — shared with the rest of the Bivium monorepo (Prisma lives in `public`).
# The indexer writes to its own schema; see DATABASE_SCHEMA / DATABASE_VIEWS_SCHEMA below.
DATABASE_URL=postgresql://bivium:bivium@localhost:5432/bivium

# Per-deploy private schema where Ponder writes during indexing + reorg handling.
# Use a unique value per deployment (e.g. include git SHA) so blue/green is safe.
DATABASE_SCHEMA=indexer_dev

# Public views schema that external apps (Prisma) read from.
# Stays stable across deployments; views get repointed atomically on each publish.
DATABASE_VIEWS_SCHEMA=indexer

# Arbitrum mainnet RPC URL (chainId 42161).
# Use a paid Alchemy/Infura/QuickNode endpoint — public RPCs rate-limit backfill.
PONDER_RPC_URL_42161=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Contract addresses (Arbitrum mainnet) — deployed via apps/contracts/script/Deploy.s.sol.
BIVIUM_ADDRESS=0xA018fac86c1BBa8f0723450AF5623F27Dde33Dd6
BIVIUM_EVENT_EMITTER_ADDRESS=0x2d5A9ad51571658450a396FC0e0c4D7cb594c430
BIVIUM_ROUTER_ADDRESS=0x7f5881d3429f24f9662A3cF5103B7EC0c2eCb47a

# Start block — earliest of the four deploy txs (BiviumEventEmitter, block
# 0x1bda9917 on Arbitrum One). Setting this to 0 would trigger a full-chain
# backfill and exhaust your RPC quota.
BIVIUM_START_BLOCK=467310871
