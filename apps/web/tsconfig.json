{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "preserve",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"composite": false,
		"noEmit": true,
		"incremental": true,
		"isolatedModules": true,
		"lib": ["dom", "dom.iterable", "es2022"],
		"strict": true,
		"plugins": [{ "name": "next" }],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["next-env.d.ts", "src/**/*", ".next/types/**/*.ts"],
	"exclude": ["node_modules", ".next"]
}
