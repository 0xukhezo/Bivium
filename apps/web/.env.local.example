# ──────────────────────────────────────────────────────────────────────────
# Privy — auth + embedded wallet provider. Required.
# Get an app id at https://dashboard.privy.io and create an app, then paste
# the App ID here. The same value goes in the Vercel project env vars.
# ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional: Alchemy API key for higher-rate-limit Arbitrum RPC. Falls back
# to a public RPC if unset.
NEXT_PUBLIC_ALCHEMY_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Bivium deployed contracts on Arbitrum mainnet (chainId 42161).
#
# Source of truth: apps/contracts/addresses/42161/config.json — keep these
# values in sync with that file on every redeploy. The Next app cannot read
# from the contracts workspace at runtime on Vercel, so these env vars must
# be set in the Vercel project settings (the same names) for production.
# ──────────────────────────────────────────────────────────────────────────

# Bivium core engine — lending math + supply/withdraw/borrow/repay internals.
NEXT_PUBLIC_BIVIUM_ADDRESS=0xcba56B1742e35687f6812e42ea8D43eD7b2a4a0F

# BiviumRouter — borrower-facing executor. Required for borrow / repay.
NEXT_PUBLIC_BIVIUM_ROUTER_ADDRESS=0x9ae169DFAa41dCF95014b88c7D9969F5d8fa58ae

# BiviumEventEmitter — canonical event source the indexer reads.
NEXT_PUBLIC_BIVIUM_EVENT_EMITTER_ADDRESS=0xca0197Eb2156FC871299c7213E3aBC9478E1575D

# BiviumProfile template — the contract every lender's EOA delegates to via
# EIP-7702. Required for the activation onboarding flow (useActivateProfile,
# useProfileDelegation, DelegationStatus pill, Lender-tab activation gate).
NEXT_PUBLIC_BIVIUM_PROFILE_ADDRESS=0x2451Dd8e00afDB39FE01eAC8fda5a3d137c71f88

# OracleFactory — used at market-creation time. Not consumed by the current
# UI but kept available for future market-creation flows.
NEXT_PUBLIC_BIVIUM_ORACLE_FACTORY_ADDRESS=0x97ff042690Ee310c098504E4c080A60Efc94D6d4

# ──────────────────────────────────────────────────────────────────────────

# Bivium backend API base URL (no trailing slash). Drives the markets list
# and any future indexer-backed read flows. Defaults to the dev nip.io
# endpoint if unset, so the app boots out-of-the-box.
NEXT_PUBLIC_BIVIUM_API_URL=https://100-51-51-210.nip.io/api/v1
