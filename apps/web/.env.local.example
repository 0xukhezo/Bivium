# WalletConnect project id (https://cloud.walletconnect.com)
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional: Alchemy API key for higher-rate-limit Arbitrum RPC
NEXT_PUBLIC_ALCHEMY_KEY=

# Bivium deployed contracts on Arbitrum mainnet.
# Reads/writes from the web app target these addresses (and the connected
# wallet itself for BiviumProfile delegate calls).
NEXT_PUBLIC_BIVIUM_ADDRESS=
NEXT_PUBLIC_BIVIUM_ROUTER_ADDRESS=
NEXT_PUBLIC_BIVIUM_EVENT_EMITTER_ADDRESS=0x2d5A9ad51571658450a396FC0e0c4D7cb594c430

# BiviumProfile template address — the canonical contract that every
# lender's EOA delegates to via EIP-7702. Required for the activation
# onboarding flow (useActivateProfile / useProfileDelegation).
NEXT_PUBLIC_BIVIUM_PROFILE_ADDRESS=

# Bivium backend API base URL (no trailing slash). Used by the markets list
# and any future indexer-backed read flows. Defaults to the dev nip.io
# endpoint if unset, so the app boots out-of-the-box.
NEXT_PUBLIC_BIVIUM_API_URL=https://100-51-51-210.nip.io/api/v1
